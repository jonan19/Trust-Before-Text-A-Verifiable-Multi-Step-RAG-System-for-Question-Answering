# =============================================================================
# Trust Before Text: API keys
#
# HOW TO USE
#   1. Copy this file to a file named exactly  .env  (it is already gitignored).
#   2. Paste each key directly after the "=" sign. No quotes, no spaces.
#   3. Leave a line empty if you have no key for it.
#
# NOTES
#   - The pipeline's synthesis step reads only GROQ_API_KEY.
#   - Experiment scripts that rotate keys (experiments/baseline_experiment.py)
#     read GROQ_API_KEY, GROQ_API_KEY_2, GROQ_API_KEY_3, ... IN ORDER and stop at
#     the first gap, so fill the numbered lines from the top, with no blank
#     line between two keys you do set.
#   - evaluation/run_eval_ramdocs_clean.py can use any one of them for a run:
#         --key-env GROQ_API_KEY_3
#   - Never commit .env. Never paste a key into chat, a log or a result file.
# =============================================================================

# --- Groq (model: openai/gpt-oss-120b) ---------------------------------------
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
GROQ_API_KEY_11=
GROQ_API_KEY_12=

# --- Optional fallbacks (read by llm_interface.py, unused by default) ---------
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Optional: Hugging Face token (removes the "unauthenticated" warning and
#     raises download rate limits; the libraries read it automatically) --------
HF_TOKEN=
