# Environments
.env
.venv/
env/
venv/
ENV/

# Python Bytecode
__pycache__/
*.py[cod]
*$py.class

# Vector Databases and Storage (regeneratable from data*/ via ingestion)
qdrant_db/
qdrant_db_corpus2/
qdrant_db_c1_copy/
qdrant_db_c2_copy/
qdrant_db_c3/
qdrant_db_c3_copy/

# Retrieval cache (regeneratable)
_retrieval_cache/

# evaluation/ is the project's test suite and is tracked in full, including the
# one-off diagnostics: each documents how a design conclusion was reached, and
# reviewers ask "did you try X?". Only regenerable output is ignored.
evaluation/results/
evaluation/_retrieval_cache/

# Documentation is always tracked.
!docs/
!docs/**

# Uploaded Files
uploaded_docs/

# IDEs and Editors
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Throwaway experiment console logs (not results; the cited JSON results are tracked elsewhere)
experiments/_*_log*.txt
data_merged/
qdrant_db_merged/
data_ramdocs/
# MultiHop-RAG (downloaded data, generated article files, its own store)
data_multihop/
qdrant_db_multihop/
data_poison/
qdrant_db_poison/
Trust_Before_Text_NLPIR.pdf

# Temporary (session-only) uploads from the local UI
data_temp/

# Permanent uploads made through the local UI
data_uploads/

# Packaged upload of the current paper: main.tex + references.bib + the three
# paper_assets figures, all of which are tracked. Verified byte-identical to the
# working copies, so it is regenerable from them.
overleaf_bundle.zip

# The B.Tech degree report (Somaiya), 77 pages. An inbound copy, downloaded here
# to be reviewed, not produced by this repo and not a deliverable of it. Its
# source lives with whoever is editing the report. Review findings belong in
# RAG_System_Observation_Log.md (see Observation 64), not in the binary, so the
# PDF itself stays untracked.
Project_Report.pdf
